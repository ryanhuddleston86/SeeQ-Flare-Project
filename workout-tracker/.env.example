# Copy to .env.local for local dev. Both values are safe to expose in a built
# static site: the anon key only grants what the row-level security policies in
# supabase/schema.sql allow (insert/select of the three known names).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
